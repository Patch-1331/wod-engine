DATABASE_URL="postgresql://wod_engine:wod_engine@localhost:5432/wod_engine?schema=public"
PORT=3001
# Shared secret gating every non-public API route. The API refuses to start
# without it. Use any long random string locally; Render generates its own.
API_TOKEN="dev-local-token-change-me"
# Comma-separated CORS allowlist. Defaults to the Vite dev server when unset.
WEB_ORIGIN="http://localhost:5173"
