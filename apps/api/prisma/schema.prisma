generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// v1 stub: one implicit row, unused by the UI. Exists so v2 multi-user/auth
// is additive rather than a migration.
model User {
  id String @id @default(cuid())
}

model Exercise {
  id       String  @id @default(cuid())
  name     String  @unique
  // Null only for general warm-up/cool-down filler not tied to a pattern
  // (Feature #63, e.g. light jogging, deep breathing).
  pattern  String? // push | pull | squat | hinge | core | cardio | null
  needsBar Boolean @default(false)
  scalable Boolean @default(false)
  unit     String  @default("reps") // reps | seconds — seconds for timed holds (e.g. plank family)

  // Progression tracking (Feature #2) — finer-grained than `pattern`, since a
  // pattern like push or core actually contains multiple independent skill
  // lines (push_horizontal vs push_vertical; core_dynamic/core_hold/core_side).
  // Null for exercises not yet part of a tracked ladder (e.g. cardio).
  line String?
  rung Int? // position within that line's chain, 0-indexed

  // Warm-up/cool-down tagging (Feature #63) — independent of `pattern`/`line`
  // so an exercise still carries its `pattern` for WOD matching while also
  // being usable as warm-up/cool-down content. Null for exercises not part
  // of either checklist.
  phase String? // warmup | cooldown | null

  altExerciseId String?
  altExercise   Exercise?  @relation("ExerciseAlt", fields: [altExerciseId], references: [id])
  substitutes   Exercise[] @relation("ExerciseAlt")

  wodMovements WodMovement[]
}

// Current rung per progression line — one row per line, v1 single-user (see
// User). Read by the scheduler when generating a WOD and advanced/dropped
// by the 3x8-to-3x5 rule after a result is logged (Feature #2).
model SkillLevel {
  id         String   @id @default(cuid())
  line       String   @unique // push_horizontal | push_vertical | pull | squat | hinge | core_dynamic | core_hold | core_side
  rung       Int      @default(0)
  updatedAt  DateTime @updatedAt
  // Set by the automatic advancement rule (#7) so the Stats "level up"
  // banner (#10) can tell a fresh advance from a drop or a manual override.
  // Null until the first automatic change; a manual override (#8) clears
  // it back to null since that's a correction, not an achievement.
  lastChange String? // advanced | dropped
}

model Wod {
  id              String  @id @default(cuid())
  name            String  @unique
  type            String // amrap | for_time | emom | tabata
  timeCapMinutes  Int
  rounds          Int?
  isNamed         Boolean @default(false)
  dominantPattern String // push | pull | squat | hinge | core | cardio

  movements   WodMovement[]
  assignments DailyAssignment[]
}

model WodMovement {
  id         String   @id @default(cuid())
  wodId      String
  wod        Wod      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  reps       Int
  order      Int
}

// One active row read by the scheduler.
model ScheduleRule {
  id                    String  @id @default(cuid())
  maxDaysPerWeek        Int     @default(5)
  patternCooldownDays   Int     @default(5)
  warmupCooldownEnabled Boolean @default(false) // Feature #63 opt-in
}

model DailyAssignment {
  id     String  @id @default(cuid())
  date   String // ISO date, one assignment per day
  wodId  String? // null for a rest day recorded before any WOD was generated
  wod    Wod?    @relation(fields: [wodId], references: [id])
  status String  @default("scheduled") // scheduled | in_progress | completed | skipped

  session WorkoutSession?
  log     WorkoutLog?

  @@unique([date])
}

// The live timer's state. roundSplits is JSON: [{ round, atSeconds }],
// written on every "round complete" tap so a locked phone or a refresh
// never loses progress.
model WorkoutSession {
  id                String          @id @default(cuid())
  assignmentId      String          @unique
  assignment        DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  startedAt         DateTime        @default(now())
  capSeconds        Int
  roundSplits       String          @default("[]") // JSON-encoded RoundSplit[]
  status            String          @default("in_progress") // in_progress | completed | abandoned
  finishedAtSeconds Int? // elapsed time when "Finish" was tapped — the natural score for a For Time WOD
  roundSplitCount   Int? // optional user-chosen round count to break high-rep movements into; null = unsplit

  // Feature #63 — stamped when each checklist is finished; read later for stats.
  warmupCompletedAt   DateTime?
  cooldownCompletedAt DateTime?
}

model WorkoutLog {
  id           String          @id @default(cuid())
  assignmentId String          @unique
  assignment   DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  resultType   String // time_seconds | rounds_reps | total_reps
  resultValue  String // e.g. "1122" (seconds), "17+3" (rounds+reps), "220" (total reps)
  rpe          Int?
  notes        String?
  createdAt    DateTime        @default(now())
}
