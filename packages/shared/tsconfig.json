{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    // TypeScript 7 removed "node" (node10). "bundler" is the replacement
    // that still pairs with `module: commonjs` -- node16 would force the
    // ESM twin off "same settings, different module format".
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist/cjs",
    "rootDir": "src"
  },
  "include": ["src"]
}
